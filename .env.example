# Copy to .env and fill in. Never commit your real .env.

# --- LLM provider ---
# Your API key for the chosen provider (default provider: Anthropic / Claude API).
ANTHROPIC_API_KEY=

# Model to use. Set to a current model string for your provider.
# Do not rely on a hardcoded default in source — set it explicitly here.
DISTIL_MODEL=

# --- Embeddings / read layer ---
# Embedder backend: "local" (provider-independent, runs a local model) or "api".
DISTIL_EMBEDDER=local
# Embedding model name for the chosen backend.
DISTIL_EMBED_MODEL=all-MiniLM-L6-v2
# (Optional) Hugging Face token — silences the "unauthenticated requests" warning
# from sentence-transformers. Get a free read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Minimum similarity for a note to clear the abstention gate (0.0–1.0).
# Below this, `ask` returns "no relevant notes" and never calls the LLM to answer.
DISTIL_RETRIEVAL_THRESHOLD=0.35
# How many candidate items to retrieve per question.
DISTIL_TOP_K=6

# --- Storage ---
DISTIL_DB_PATH=./data/distil.db
DISTIL_KB_DIR=./kb
# When hosting (e.g. Railway), point these at the mounted volume, e.g. /data/distil.db and /data/kb.

# --- YouTube ingest ---
# URL of a separately-run bgutil-ytdlp-pot-provider HTTP server (e.g. Railway private
# networking address). When set, yt-dlp requests a proof-of-origin token from it to make
# fetches look more legitimate to YouTube's bot check on datacenter IPs. Not a guaranteed
# bypass — see DEPLOY_RAILWAY.md. Leave unset for local development.
DISTIL_POT_PROVIDER_URL=

# --- Hosting / auth ---
# Set true when exposing the app on a public URL. The app refuses to serve in public
# mode unless DISTIL_AUTH_SECRET is set.
DISTIL_PUBLIC=false
# Single-user login secret. REQUIRED whenever the app is not bound to localhost.
DISTIL_AUTH_SECRET=

# --- External collector queue (bot-checked YouTube fetches) ---
# Set these on the SERVER (e.g. Railway). Separate, revocable credential for a collector
# fetching transcripts from a trusted machine elsewhere (see AGENTS.md's external-collector
# queue entry). Grants only claim/submit/report-unfetchable — never owner access. Leave unset
# to keep the queue unusable (fails closed).
DISTIL_COLLECTOR_TOKEN=
# How long a claimed video is leased to a collector before it returns to the pool (seconds).
DISTIL_COLLECTOR_LEASE_SECONDS=600
# How long a video waits for external collection before failing cleanly (seconds, default 7 days).
DISTIL_COLLECTOR_EXPIRY_SECONDS=604800

# --- External collector program (`distil collector-run`) ---
# Set these on the COLLECTOR machine instead (your laptop/desktop, not the server) — see
# RUNBOOK.md's "Run the external collector" section. DISTIL_COLLECTOR_TOKEN above must match
# the value the server was configured with.
# The server's own address (not this machine's) — same value the site is reachable at.
DISTIL_COLLECTOR_SERVER_URL=
# Which browser's cookies yt-dlp should read for a signed-in fetch, e.g. "chrome", "firefox",
# "safari", or "chrome:Default" / "firefox:some-profile" for a specific profile. Leave unset to
# fetch anonymously (no browser needed) — the collector always reports which mode it used.
DISTIL_COLLECTOR_BROWSER=
# How long to wait before checking for new work when the queue is empty (seconds).
DISTIL_COLLECTOR_POLL_SECONDS=30
# How long to pause between fetches so the collector never bursts requests (seconds).
DISTIL_COLLECTOR_FETCH_PAUSE_SECONDS=5

# --- Behavior ---
# Fraction of application links reserved as novelty/serendipity (anti filter-bubble). 0.0–1.0
DISTIL_NOVELTY_RATIO=0.2

# EMA learning rate for profile weight updates (0.0–1.0). Lower = more gradual.
DISTIL_PROFILE_ALPHA=0.3

# --- Per-stage model overrides ---
# Every LLM-calling pipeline stage resolves its own model by name (distil/model_config.py):
# DISTIL_MODEL_<STAGE> overrides that one stage only. Stages: TRIAGE, EXTRACT, LINK, NOTE,
# GRAPH, CANONICALIZE (all fall back to DISTIL_MODEL above when unset — today's behavior,
# unchanged) and SUMMARY (falls back to a hardcoded Haiku-tier default instead, since
# summarizing is compression, not judgement — see the narrative summary section below). All
# stages share the same ANTHROPIC_API_KEY; only the model string differs. Uncomment to try a
# different model for one stage without touching code, e.g.:
# DISTIL_MODEL_SUMMARY=claude-haiku-4-5
# DISTIL_MODEL_TRIAGE=claude-opus-5

# --- Narrative summary (reads the whole transcript directly, beside the grounded note) ---
# Target characters per transcript chunk before summarizing (sentence boundaries are never
# split). ~12,000 chars is roughly 15-20 minutes of spoken content — small enough that one
# completion covers a chunk thoroughly, large enough to keep call count low on a typical video.
DISTIL_SUMMARY_CHUNK_CHARS=12000
# How many times to retry a chunk or merge completion that comes back too thin (or drops the
# connection) before giving up honestly.
DISTIL_SUMMARY_MAX_RETRIES=3
